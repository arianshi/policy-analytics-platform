# ---- Copy to .env (git-ignored). Everything is optional: with no keys the platform runs on the offline rule-based model. ----

# Government data: true = call Data.gov.sg / SingStat live (with cache + snapshot fallback); false = bundled snapshots only.
LIVE_DATA=true

# LLM providers are tried in this order; those without credentials are skipped. "offline" is always the last resort.
LLM_PROVIDER_ORDER=anthropic,openai,gemini,bedrock,azure,offline
LLM_BUDGET_USD=0.50

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort per call: low | medium | high | xhigh | max (higher = slower and more tokens).
ANTHROPIC_EFFORT=low

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# AWS Bedrock uses the standard AWS credential chain (env vars, profile, or IAM role).
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Service
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
MAX_CONCURRENT_ANALYSES=4
RATE_LIMIT_PER_MIN=30
# Demo feature: lets clients ask for simulated failures. Set false in production.
ALLOW_FAULT_INJECTION=true
LOG_LEVEL=INFO
